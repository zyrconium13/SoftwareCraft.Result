<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>SoftwareCraft.Functional</RootNamespace>
        <LangVersion>latest</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>6.4.1.0</Version>
        <Authors>SoftwareCraft</Authors>
        <Company>SoftwareCraft</Company>
        <PackageProjectUrl>https://github.com/zyrconium13/SoftwareCraft.Result</PackageProjectUrl>
        <RepositoryUrl>https://github.com/zyrconium13/SoftwareCraft.Result</RepositoryUrl>
        <PackageTags>result c-sharp functional-programming dotnet core standard</PackageTags>
        <AssemblyVersion>6.4.1.0</AssemblyVersion>
        <FileVersion>6.4.1.0</FileVersion>
        <Description>SoftwareCraft.Result represents the OOP implementation of a functional concept. Instead of throwing an exception, return a Result, and the code will be much cleaner and the intent much clearer.</Description>
        <PackageReleaseNotes>Add monoidal error handling and error mapping arguments to Apply (Applicative Functor).</PackageReleaseNotes>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SoftwareCraft.Forge" Version="1.0.2" />
    </ItemGroup>

</Project>